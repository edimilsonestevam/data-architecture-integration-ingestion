		<table name="slave_master_info" type="SYSTEM_TABLE" row_count="0" spec="" >
			<comment><![CDATA[Master Information]]></comment>
			<column name="Number_of_lines" type="INT" mandatory="y" unsigned="y" >
				<comment><![CDATA[Number of lines in the file.]]></comment>
			</column>
			<column name="Master_log_name" type="TEXT" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[The name of the master binary log currently being read from the master.]]></comment>
			</column>
			<column name="Master_log_pos" type="BIGINT" mandatory="y" unsigned="y" >
				<comment><![CDATA[The master log position of the last read event.]]></comment>
			</column>
			<column name="Host" type="VARCHAR" length="255" >
				<column_options><![CDATA[CHARACTER SET ascii COLLATE ascii_general_ci]]></column_options>
				<comment><![CDATA[The host name of the source.]]></comment>
			</column>
			<column name="User_name" type="TEXT" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[The user name used to connect to the master.]]></comment>
			</column>
			<column name="User_password" type="TEXT" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[The password used to connect to the master.]]></comment>
			</column>
			<column name="Port" type="INT" mandatory="y" unsigned="y" >
				<comment><![CDATA[The network port used to connect to the master.]]></comment>
			</column>
			<column name="Connect_retry" type="INT" mandatory="y" unsigned="y" >
				<comment><![CDATA[The period (in seconds) that the slave will wait before trying to reconnect to the master.]]></comment>
			</column>
			<column name="Enabled_ssl" type="BOOLEAN" mandatory="y" >
				<comment><![CDATA[Indicates whether the server supports SSL connections.]]></comment>
			</column>
			<column name="Ssl_ca" type="TEXT" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[The file used for the Certificate Authority (CA) certificate.]]></comment>
			</column>
			<column name="Ssl_capath" type="TEXT" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[The path to the Certificate Authority (CA) certificates.]]></comment>
			</column>
			<column name="Ssl_cert" type="TEXT" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[The name of the SSL certificate file.]]></comment>
			</column>
			<column name="Ssl_cipher" type="TEXT" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[The name of the cipher in use for the SSL connection.]]></comment>
			</column>
			<column name="Ssl_key" type="TEXT" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[The name of the SSL key file.]]></comment>
			</column>
			<column name="Ssl_verify_server_cert" type="BOOLEAN" mandatory="y" >
				<comment><![CDATA[Whether to verify the server certificate.]]></comment>
			</column>
			<column name="Heartbeat" type="FLOAT" mandatory="y" />
			<column name="Bind" type="TEXT" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[Displays which interface is employed when connecting to the MySQL server]]></comment>
			</column>
			<column name="Ignored_server_ids" type="TEXT" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[The number of server IDs to be ignored, followed by the actual server IDs]]></comment>
			</column>
			<column name="Uuid" type="TEXT" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[The master server uuid.]]></comment>
			</column>
			<column name="Retry_count" type="BIGINT" mandatory="y" unsigned="y" >
				<comment><![CDATA[Number of reconnect attempts, to the master, before giving up.]]></comment>
			</column>
			<column name="Ssl_crl" type="TEXT" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[The file used for the Certificate Revocation List (CRL)]]></comment>
			</column>
			<column name="Ssl_crlpath" type="TEXT" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[The path used for Certificate Revocation List (CRL) files]]></comment>
			</column>
			<column name="Enabled_auto_position" type="BOOLEAN" mandatory="y" >
				<comment><![CDATA[Indicates whether GTIDs will be used to retrieve events from the master.]]></comment>
			</column>
			<column name="Channel_name" type="VARCHAR" length="64" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci]]></column_options>
				<comment><![CDATA[The channel on which the replica is connected to a source. Used in Multisource Replication]]></comment>
			</column>
			<column name="Tls_version" type="TEXT" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[Tls version]]></comment>
			</column>
			<column name="Public_key_path" type="TEXT" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[The file containing public key of master server.]]></comment>
			</column>
			<column name="Get_public_key" type="BOOLEAN" mandatory="y" >
				<comment><![CDATA[Preference to get public key from master.]]></comment>
			</column>
			<column name="Network_namespace" type="TEXT" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[Network namespace used for communication with the master server.]]></comment>
			</column>
			<column name="Master_compression_algorithm" type="VARCHAR" length="64" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[Compression algorithm supported for data transfer between source and replica.]]></comment>
			</column>
			<column name="Master_zstd_compression_level" type="INT" mandatory="y" unsigned="y" >
				<comment><![CDATA[Compression level associated with zstd compression algorithm.]]></comment>
			</column>
			<column name="Tls_ciphersuites" type="TEXT" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[Ciphersuites used for TLS 1.3 communication with the master server.]]></comment>
			</column>
			<column name="Source_connection_auto_failover" type="BOOLEAN" mandatory="y" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Indicates whether the channel connection failover is enabled.]]></comment>
			</column>
			<column name="Gtid_only" type="BOOLEAN" mandatory="y" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Indicates if this channel only uses GTIDs and does not persist positions.]]></comment>
			</column>
			<index name="pk_slave_master_info" unique="PRIMARY_KEY" >
				<column name="Channel_name" />
			</index>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 STATS_PERSISTENT=0 ROW_FORMAT=DYNAMIC]]></options>
		</table>
		<table name="slave_relay_log_info" type="SYSTEM_TABLE" row_count="0" spec="" >
			<comment><![CDATA[Relay Log Information]]></comment>
			<column name="Number_of_lines" type="INT" mandatory="y" unsigned="y" >
				<comment><![CDATA[Number of lines in the file or rows in the table. Used to version table definitions.]]></comment>
			</column>
			<column name="Relay_log_name" type="TEXT" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[The name of the current relay log file.]]></comment>
			</column>
			<column name="Relay_log_pos" type="BIGINT" unsigned="y" >
				<comment><![CDATA[The relay log position of the last executed event.]]></comment>
			</column>
			<column name="Master_log_name" type="TEXT" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[The name of the master binary log file from which the events in the relay log file were read.]]></comment>
			</column>
			<column name="Master_log_pos" type="BIGINT" unsigned="y" >
				<comment><![CDATA[The master log position of the last executed event.]]></comment>
			</column>
			<column name="Sql_delay" type="INT" >
				<comment><![CDATA[The number of seconds that the slave must lag behind the master.]]></comment>
			</column>
			<column name="Number_of_workers" type="INT" unsigned="y" />
			<column name="Id" type="INT" unsigned="y" >
				<comment><![CDATA[Internal Id that uniquely identifies this record.]]></comment>
			</column>
			<column name="Channel_name" type="VARCHAR" length="64" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci]]></column_options>
				<comment><![CDATA[The channel on which the replica is connected to a source. Used in Multisource Replication]]></comment>
			</column>
			<column name="Privilege_checks_username" type="VARCHAR" length="32" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[Username part of PRIVILEGE_CHECKS_USER.]]></comment>
			</column>
			<column name="Privilege_checks_hostname" type="VARCHAR" length="255" >
				<column_options><![CDATA[CHARACTER SET ascii COLLATE ascii_general_ci]]></column_options>
				<comment><![CDATA[Hostname part of PRIVILEGE_CHECKS_USER.]]></comment>
			</column>
			<column name="Require_row_format" type="BOOLEAN" mandatory="y" >
				<comment><![CDATA[Indicates whether the channel shall only accept row based events.]]></comment>
			</column>
			<column name="Require_table_primary_key_check" type="ENUM" mandatory="y" >
				<defo><![CDATA['STREAM']]></defo>
				<enumeration><![CDATA['STREAM','ON','OFF','GENERATE']]></enumeration>
				<comment><![CDATA[Indicates what is the channel policy regarding tables without primary keys on create and alter table queries]]></comment>
			</column>
			<column name="Assign_gtids_to_anonymous_transactions_type" type="ENUM" mandatory="y" >
				<defo><![CDATA['OFF']]></defo>
				<enumeration><![CDATA['OFF','LOCAL','UUID']]></enumeration>
				<comment><![CDATA[Indicates whether the channel will generate a new GTID for anonymous transactions. OFF means that anonymous transactions will remain anonymous. LOCAL means that anonymous transactions will be assigned a newly generated GTID based on server_uuid. UUID indicates that anonymous transactions will be assigned a newly generated GTID based on Assign_gtids_to_anonymous_transactions_value]]></comment>
			</column>
			<column name="Assign_gtids_to_anonymous_transactions_value" type="TEXT" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_bin]]></column_options>
				<comment><![CDATA[Indicates the UUID used while generating GTIDs for anonymous transactions]]></comment>
			</column>
			<index name="pk_slave_relay_log_info" unique="PRIMARY_KEY" >
				<column name="Channel_name" />
			</index>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 STATS_PERSISTENT=0 ROW_FORMAT=DYNAMIC]]></options>
		</table>
