		<table name="replication_asynchronous_connection_failover" type="SYSTEM_TABLE" row_count="0" spec="" >
			<comment><![CDATA[The source configuration details]]></comment>
			<column name="Channel_name" type="CHAR" length="64" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci]]></column_options>
				<comment><![CDATA[The replication channel name that connects source and replica.]]></comment>
			</column>
			<column name="Host" type="CHAR" length="255" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET ascii COLLATE ascii_general_ci]]></column_options>
				<comment><![CDATA[The source hostname that the replica will attempt to switch over the replication connection to in case of a failure.]]></comment>
			</column>
			<column name="Port" type="INT" mandatory="y" unsigned="y" >
				<comment><![CDATA[The source port that the replica will attempt to switch over the replication connection to in case of a failure.]]></comment>
			</column>
			<column name="Network_namespace" type="CHAR" length="64" mandatory="y" >
				<comment><![CDATA[The source network namespace that the replica will attempt to switch over the replication connection to in case of a failure. If its value is empty, connections use the default (global) namespace.]]></comment>
			</column>
			<column name="Weight" type="TINYINT" mandatory="y" unsigned="y" >
				<comment><![CDATA[The order in which the replica shall try to switch the connection over to when there are failures. Weight can be set to a number between 1 and 100, where 100 is the highest weight and 1 the lowest.]]></comment>
			</column>
			<column name="Managed_name" type="CHAR" length="64" mandatory="y" >
				<defo><![CDATA['']]></defo>
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci]]></column_options>
				<comment><![CDATA[The name of the group which this server belongs to.]]></comment>
			</column>
			<index name="pk_replication_asynchronous_connection_failover" unique="PRIMARY_KEY" >
				<column name="Channel_name" />
				<column name="Host" />
				<column name="Port" />
				<column name="Network_namespace" />
				<column name="Managed_name" />
			</index>
			<index name="Channel_name" unique="NORMAL" >
				<column name="Channel_name" />
				<column name="Managed_name" />
			</index>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 STATS_PERSISTENT=0 ROW_FORMAT=DYNAMIC]]></options>
		</table>
		<table name="replication_asynchronous_connection_failover_managed" type="SYSTEM_TABLE" row_count="0" spec="" >
			<comment><![CDATA[The managed source configuration details]]></comment>
			<column name="Channel_name" type="CHAR" length="64" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci]]></column_options>
				<comment><![CDATA[The replication channel name that connects source and replica.]]></comment>
			</column>
			<column name="Managed_name" type="CHAR" length="64" mandatory="y" >
				<defo><![CDATA['']]></defo>
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci]]></column_options>
				<comment><![CDATA[The name of the source which needs to be managed.]]></comment>
			</column>
			<column name="Managed_type" type="CHAR" length="64" mandatory="y" >
				<defo><![CDATA['']]></defo>
				<column_options><![CDATA[CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci]]></column_options>
				<comment><![CDATA[Determines the managed type.]]></comment>
			</column>
			<column name="Configuration" type="JSON" >
				<comment><![CDATA[The data to help manage group. For Managed_type = GroupReplication, Configuration value should contain {"Primary_weight": 80, "Secondary_weight": 60}, so that it assigns weight=80 to PRIMARY of the group, and weight=60 for rest of the members in mysql.replication_asynchronous_connection_failover table.]]></comment>
			</column>
			<index name="pk_replication_asynchronous_connection_failover_ma" unique="PRIMARY_KEY" >
				<column name="Channel_name" />
				<column name="Managed_name" />
			</index>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 STATS_PERSISTENT=0 ROW_FORMAT=DYNAMIC]]></options>
		</table>
		<table name="replication_group_configuration_version" type="SYSTEM_TABLE" row_count="1" spec="" >
			<comment><![CDATA[The group configuration version.]]></comment>
			<column name="name" type="CHAR" length="255" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET ascii COLLATE ascii_general_ci]]></column_options>
				<comment><![CDATA[The configuration name.]]></comment>
			</column>
			<column name="version" type="BIGINT" mandatory="y" unsigned="y" >
				<comment><![CDATA[The version of the configuration name.]]></comment>
			</column>
