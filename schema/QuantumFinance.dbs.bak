				<column name="name" />
			</index>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci STATS_PERSISTENT=0 ROW_FORMAT=DYNAMIC]]></options>
		</table>
		<table name="replication_group_member_actions" type="SYSTEM_TABLE" row_count="2" spec="" >
			<comment><![CDATA[The member actions configuration.]]></comment>
			<column name="name" type="CHAR" length="255" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET ascii COLLATE ascii_general_ci]]></column_options>
				<comment><![CDATA[The action name.]]></comment>
			</column>
			<column name="event" type="CHAR" length="64" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET ascii COLLATE ascii_general_ci]]></column_options>
				<comment><![CDATA[The event that will trigger the action.]]></comment>
			</column>
			<column name="enabled" type="BOOLEAN" mandatory="y" >
				<comment><![CDATA[Whether the action is enabled.]]></comment>
			</column>
			<column name="type" type="CHAR" length="64" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET ascii COLLATE ascii_general_ci]]></column_options>
				<comment><![CDATA[The action type.]]></comment>
			</column>
			<column name="priority" type="TINYINT" mandatory="y" unsigned="y" >
				<comment><![CDATA[The order on which the action will be run, value between 1 and 100, lower values first.]]></comment>
			</column>
			<column name="error_handling" type="CHAR" length="64" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET ascii COLLATE ascii_general_ci]]></column_options>
				<comment><![CDATA[On errors during the action will be handled: IGNORE, CRITICAL.]]></comment>
			</column>
			<index name="pk_replication_group_member_actions" unique="PRIMARY_KEY" >
				<column name="name" />
				<column name="event" />
			</index>
			<index name="event" unique="NORMAL" >
				<column name="event" />
			</index>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci STATS_PERSISTENT=0 ROW_FORMAT=DYNAMIC]]></options>
		</table>
