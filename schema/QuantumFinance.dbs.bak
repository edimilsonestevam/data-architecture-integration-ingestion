			</column>
			<column name="comment" type="VARCHAR" length="1024" />
			<column name="default_value" type="FLOAT" >
				<identity><![CDATA[GENERATED  ALWAYS AS ((case `cost_name` when _utf8mb3'io_block_read_cost' then 1.0 when _utf8mb3'memory_block_read_cost' then 0.25 else NULL end))]]></identity>
			</column>
			<index name="pk_engine_cost" unique="PRIMARY_KEY" >
